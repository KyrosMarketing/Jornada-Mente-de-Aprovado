{
  "name": "jornada-mente-de-aprovado",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:release": "npm run typecheck && tsx scripts/check-release.ts && vite build --mode production-ready",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "package:hostinger": "npm run build && tsx scripts/package-hostinger.ts",
    "package:hostinger:release": "npm run build:release && tsx scripts/package-hostinger.ts --release",
    "test:hostinger": "tsx scripts/test-hostinger.ts",
    "package:widget": "npm run build && tsx scripts/package-widget.ts",
    "test:widget": "tsx scripts/test-widget.ts",
    "widget:embed": "tsx scripts/update-widget-embed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "7.3.7"
  }
}
